# Copier vers .env et renseigner les valeurs (le .env réel est gitignored).

# Twelve Data — marchés traditionnels (actions/forex ; indices/commodités via ETF).
# Clé gratuite : https://twelvedata.com/account/api-keys
# Injectée côté proxy Vite (/tdapi) → jamais exposée au bundle navigateur.
TWELVE_DATA_KEY=

# FRED — macro / masse monétaire M2 (St. Louis Fed).
# Clé gratuite : https://fredaccount.stlouisfed.org/apikeys
# Injectée côté proxy Vite (/fredapi) → jamais exposée au bundle navigateur.
# Repli utilisé quand l'utilisateur n'a saisi aucune clé dans les Réglages.
FRED_API_KEY=

# Coinalyze — données dérivées (OI, funding, long/short, liquidations).
# Clé gratuite : https://coinalyze.net/
# Injectée côté proxy Vite (/coinalyzeapi) → jamais exposée au bundle navigateur.
# Repli utilisé quand l'utilisateur n'a saisi aucune clé dans les Réglages.
COINALYZE_API_KEY=

# SoSoValue — flux ETF spot BTC/ETH/SOL (panneau ON-CHAIN).
# Clé gratuite (plan Demo, 20 req/min) : https://sosovalue.com/developer
# Injectée côté proxy (/sosoapi, en-tête x-soso-api-key) → jamais exposée au bundle navigateur.
# Repli utilisé quand l'utilisateur n'a saisi aucune clé dans les Réglages.
SOSOVALUE_API_KEY=

# Etherscan v2 — réseau ETH : gas recommandé, supply, nombre de nœuds (panneau ON-CHAIN).
# Clé gratuite : https://etherscan.io/register
# Injectée côté proxy (/ethscanapi, paramètre apikey) → jamais exposée au bundle navigateur.
# Repli utilisé quand l'utilisateur n'a saisi aucune clé dans les Réglages.
ETHERSCAN_API_KEY=

# Telegram (OPTIONNEL) — relais des alertes « onglet fermé » du daemon axiomd (Phase 2.E3).
# Lues UNIQUEMENT par le daemon (apps/daemon), jamais par le bundle navigateur. Si les
# DEUX sont renseignées, chaque déclenchement d'alerte est aussi envoyé en message Telegram.
# 1) Créer un bot via @BotFather → récupérer le token.
# 2) Récupérer son chat_id (ex. via @userinfobot). Laisser vide pour désactiver le relais.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
