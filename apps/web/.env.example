# ─────────────────────────────────────────────────────────────────────────────
# AXIOM — source UNIQUE des secrets (gitignorée une fois copiée en .env)
#
#   cp apps/web/.env.example apps/web/.env
#
# Lue par :
#   • Vite en dev  (proxys /fredapi, /coinalyzeapi, /tdapi, /sosoapi, /ethscanapi, /bgapi, /cqapi)
#   • le daemon axiomd en prod (apps/daemon — même fichier, chemin relatif)
#
# Toutes les clés sont OPTIONNELLES : l’app démarre sans elles ; les panneaux
# concernés se dégradent (message « clé manquante » / 401 amont).
# Les clés ne sont JAMAIS embarquées dans le bundle navigateur.
# ─────────────────────────────────────────────────────────────────────────────

# FRED (macro US — masse monétaire, séries macro dans le panneau Macro / RATE)
FRED_API_KEY=

# Coinalyze (OI, funding, L/S, liquidations agrégées — panneau DES + sous-panes chart)
COINALYZE_API_KEY=

# Twelve Data (marchés traditionnels : actions, forex, ETF — source « TradFi »)
TWELVE_DATA_KEY=

# SoSoValue (flux ETF spot BTC/ETH/SOL — panneau ON-CHAIN)
SOSOVALUE_API_KEY=

# Etherscan v2 (activité réseau ETH — panneau ON-CHAIN + gros transferts stables — fenêtre WHALES)
# ⚠️ Depuis la v2, l'API refuse TOUTE requête sans clé (plus de mode dégradé keyless).
ETHERSCAN_API_KEY=

# ── Relais Telegram des alertes (daemon uniquement, optionnel) ───────────────
# Si les deux sont renseignés, chaque déclenchement d’alerte est aussi poussé
# via l’API Bot Telegram (en plus de la notification macOS).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Process daemon (optionnel, hors fichier .env aussi possible) ─────────────
# export AXIOMD_PORT=8787
# Pour `pnpm dev` lancé sans `pnpm up`, doit rester une URL HTTP loopback.
# `scripts/axiom-up.sh` l'injecte automatiquement depuis AXIOMD_PORT.
VITE_AXIOMD_URL=http://127.0.0.1:8787

# BGeometrics / bitcoin-data.com (on-chain BTC : MVRV-Z, SOPR, NUPL, flux ETF, hashrate)
# Repli injecté côté proxy (/bgapi) ; une clé saisie dans les Réglages reste prioritaire.
# Clé gratuite : https://bitcoin-data.com/
BGEOMETRICS_API_KEY=

# CryptoQuant BASIC (flux takers toutes places — DES ; production des mineurs cotés — CHAIN)
# Licence PERSONNELLE : repli du proxy Vite (/cqapi) et du daemon 127.0.0.1 UNIQUEMENT,
# jamais sur Vercel (aucune variable serveur ; sans clé personnelle, aucun appel).
# Une clé saisie dans les Réglages reste prioritaire. Offre : https://cryptoquant.com/
CRYPTOQUANT_API_KEY=
