{
  "name": "axiom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AXIOM Terminal — charting & orderflow crypto (build perso mono-utilisateur)",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @axiom/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "daemon": "bun apps/daemon/src/index.ts",
    "prod": "pnpm --filter @axiom/web build && bun apps/daemon/src/index.ts",
    "up": "bash scripts/axiom-up.sh",
    "up:prod": "bash scripts/axiom-up.sh --prod",
    "check": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.0"
  }
}
