{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "pnpm --filter @axiom/web exec vite --port $PORT",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @axiom/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/extapi/:path*",
      "destination": "/api/proxy?__axiom_route=extapi&__axiom_path=:path"
    },
    {
      "source": "/extapi/:path*/",
      "destination": "/api/proxy?__axiom_route=extapi&__axiom_path=:path/"
    },
    {
      "source": "/fredapi/:path*",
      "destination": "/api/proxy?__axiom_route=fredapi&__axiom_path=:path"
    },
    {
      "source": "/fredapi/:path*/",
      "destination": "/api/proxy?__axiom_route=fredapi&__axiom_path=:path/"
    },
    {
      "source": "/coinalyzeapi/:path*",
      "destination": "/api/proxy?__axiom_route=coinalyzeapi&__axiom_path=:path"
    },
    {
      "source": "/coinalyzeapi/:path*/",
      "destination": "/api/proxy?__axiom_route=coinalyzeapi&__axiom_path=:path/"
    },
    {
      "source": "/tdapi/:path*",
      "destination": "/api/proxy?__axiom_route=tdapi&__axiom_path=:path"
    },
    {
      "source": "/tdapi/:path*/",
      "destination": "/api/proxy?__axiom_route=tdapi&__axiom_path=:path/"
    },
    {
      "source": "/mexcapi/:path*",
      "destination": "/api/proxy?__axiom_route=mexcapi&__axiom_path=:path"
    },
    {
      "source": "/mexcapi/:path*/",
      "destination": "/api/proxy?__axiom_route=mexcapi&__axiom_path=:path/"
    },
    {
      "source": "/sosoapi/:path*",
      "destination": "/api/proxy?__axiom_route=sosoapi&__axiom_path=:path"
    },
    {
      "source": "/sosoapi/:path*/",
      "destination": "/api/proxy?__axiom_route=sosoapi&__axiom_path=:path/"
    },
    {
      "source": "/bgapi/:path*",
      "destination": "/api/proxy?__axiom_route=bgapi&__axiom_path=:path"
    },
    {
      "source": "/bgapi/:path*/",
      "destination": "/api/proxy?__axiom_route=bgapi&__axiom_path=:path/"
    },
    {
      "source": "/ethscanapi/:path*",
      "destination": "/api/proxy?__axiom_route=ethscanapi&__axiom_path=:path"
    },
    {
      "source": "/ethscanapi/:path*/",
      "destination": "/api/proxy?__axiom_route=ethscanapi&__axiom_path=:path/"
    },
    {
      "source": "/ccdataapi/:path*",
      "destination": "/api/proxy?__axiom_route=ccdataapi&__axiom_path=:path"
    },
    {
      "source": "/ccdataapi/:path*/",
      "destination": "/api/proxy?__axiom_route=ccdataapi&__axiom_path=:path/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' blob: data: wss://stream.binance.com:9443 wss://fstream.binance.com wss://stream.bybit.com wss://ws.okx.com:8443 wss://ws.kraken.com wss://advanced-trade-ws.coinbase.com wss://api.hyperliquid.xyz https://api.binance.com https://fapi.binance.com https://dapi.binance.com https://api.bybit.com https://api.kraken.com https://api.coinbase.com https://api.hyperliquid.xyz https://www.okx.com https://api.llama.fi https://stablecoins.llama.fi https://finnhub.io https://api.coingecko.com https://mempool.space https://api.blockchain.info https://community-api.coinmetrics.io https://services5.arcgis.com https://services9.arcgis.com https://solana-rpc.publicnode.com https://api.mainnet-beta.solana.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
