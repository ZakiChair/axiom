{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "devCommand": "pnpm --filter @axiom/web exec vite --port $PORT",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @axiom/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/extapi/:path*",
      "destination": "/api/proxy?__axiom_route=extapi&__axiom_path=:path"
    },
    {
      "source": "/extapi/:path*/",
      "destination": "/api/proxy?__axiom_route=extapi&__axiom_path=:path/"
    },
    {
      "source": "/fredapi/:path*",
      "destination": "/api/proxy?__axiom_route=fredapi&__axiom_path=:path"
    },
    {
      "source": "/fredapi/:path*/",
      "destination": "/api/proxy?__axiom_route=fredapi&__axiom_path=:path/"
    },
    {
      "source": "/coinalyzeapi/:path*",
      "destination": "/api/proxy?__axiom_route=coinalyzeapi&__axiom_path=:path"
    },
    {
      "source": "/coinalyzeapi/:path*/",
      "destination": "/api/proxy?__axiom_route=coinalyzeapi&__axiom_path=:path/"
    },
    {
      "source": "/tdapi/:path*",
      "destination": "/api/proxy?__axiom_route=tdapi&__axiom_path=:path"
    },
    {
      "source": "/tdapi/:path*/",
      "destination": "/api/proxy?__axiom_route=tdapi&__axiom_path=:path/"
    },
    {
      "source": "/mexcapi/:path*",
      "destination": "/api/proxy?__axiom_route=mexcapi&__axiom_path=:path"
    },
    {
      "source": "/mexcapi/:path*/",
      "destination": "/api/proxy?__axiom_route=mexcapi&__axiom_path=:path/"
    },
    {
      "source": "/sosoapi/:path*",
      "destination": "/api/proxy?__axiom_route=sosoapi&__axiom_path=:path"
    },
    {
      "source": "/sosoapi/:path*/",
      "destination": "/api/proxy?__axiom_route=sosoapi&__axiom_path=:path/"
    },
    {
      "source": "/bgapi/:path*",
      "destination": "/api/proxy?__axiom_route=bgapi&__axiom_path=:path"
    },
    {
      "source": "/bgapi/:path*/",
      "destination": "/api/proxy?__axiom_route=bgapi&__axiom_path=:path/"
    },
    {
      "source": "/ethscanapi/:path*",
      "destination": "/api/proxy?__axiom_route=ethscanapi&__axiom_path=:path"
    },
    {
      "source": "/ethscanapi/:path*/",
      "destination": "/api/proxy?__axiom_route=ethscanapi&__axiom_path=:path/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
